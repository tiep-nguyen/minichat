# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
# Pro lokální vývoj (npm run dev):
DATABASE_URL=postgresql://postgres:password@localhost:5432/tmechat

# Pro docker-compose (obě služby v Dockeru) — zakomentuj řádek výše a odkomentuj tento:
# DATABASE_URL=postgresql://postgres:password@db:5432/tmechat

# AES-256-GCM encryption key (32 bytes = 64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_hex_char_key_here

# JWT
JWT_SECRET=your_minimum_32_character_jwt_secret_here
JWT_EXPIRES_IN=1h

# Tenant cache TTL in seconds
TENANT_CACHE_TTL=60

# MS Teams integration
TEAMS_TIMEOUT_MS=8000
TEAMS_MAX_RETRY=2
